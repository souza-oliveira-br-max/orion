<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#e94560"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatusCabecalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Parado"
            android:textColor="#ff6b6b"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servidor"
            android:textColor="#eee"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0f3460"
            android:textColor="#eee"
            android:padding="10dp"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numero"
            android:textColor="#eee"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0f3460"
            android:textColor="#eee"
            android:padding="10dp"
            android:textSize="12sp"
            android:inputType="phone"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INICIAR"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PARAR"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSendNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENVIAR AGORA"
            android:textSize="12sp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ULTIMA COLETA"
            android:textColor="#e94560"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f3460"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CID: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvLac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LAC: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvBanda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banda: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvRsrp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSRP: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvOperadora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Operadora: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS"
            android:textColor="#e94560"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f3460"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lat: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvLng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lng: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvPrecisao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Precisao: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENVIOS"
            android:textColor="#e94560"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f3460"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTotalEnvios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total: 0"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvUltimoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ultimo: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvTempoDesdeEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desde: —"
                android:textColor="#eee"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIZINHAS"
            android:textColor="#e94560"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvVizinhas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0f3460"
            android:padding="10dp"
            android:text="Nenhuma"
            android:textColor="#eee"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOG"
            android:textColor="#e94560"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:padding="10dp"
            android:text="—"
            android:textColor="#0f0"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>
</ScrollView>